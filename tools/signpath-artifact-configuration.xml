<?xml version="1.0" encoding="utf-8"?>
<!--
  Paste this into the SignPath project: Artifact configurations > default (or a new one).
  The release workflow uploads RoboXCopy.exe as a GitHub artifact (a zip with the exe at its root)
  and SignPath signs the exe with Authenticode.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="RoboXCopy.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
